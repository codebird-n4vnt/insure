# Private devnet RPC recommended (the public one rate-limits account scans).
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional; defaults to the RPC URL with ws(s)://
# NEXT_PUBLIC_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet
# Circle devnet USDC. Must equal Config.usdc_mint on-chain.
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# The oracle keeper / API (cached account reads, evidence bundles, Blinks).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
# Public URL of this site (social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In-browser "Demo Wallet (devnet)" for people without a wallet. Never shown on mainnet.
# NEXT_PUBLIC_DEMO_WALLET=false
