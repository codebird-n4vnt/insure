# ── Solana ────────────────────────────────────────────────────────────────
# Any devnet RPC. A private one (Helius, Triton, …) is strongly recommended:
# the public endpoint rate-limits getProgramAccounts.
RPC_URL=https://api.devnet.solana.com
# WS_URL=wss://api.devnet.solana.com
CLUSTER=devnet

# The oracle key that signs settle_claim. Base58 secret, JSON byte array, or a
# path to a keypair file. Must match Config.oracle_authority on-chain
# (set with `npm run init-config`). Keep ~0.1 SOL in it for fees + ATA rent.
# Leave empty to run the API read-only.
ORACLE_KEYPAIR=./oracle-keypair.json
KEEPER_ENABLED=true
POLL_INTERVAL_SECONDS=60
# Claims with no usable data this long after filing are rejected (claimant can re-file).
DATA_DEADLINE_HOURS=72
EVIDENCE_DIR=./data/evidence

# ── Data sources ──────────────────────────────────────────────────────────
# Weather uses Open-Meteo: free, no key needed.

# Flights: set at least one. Aviationstack free plan = 100 req/month, HTTP only.
AVIATIONSTACK_API_KEY=
# AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1
# AeroDataBox on RapidAPI (has a free tier, HTTPS, historical by date). Tried first if set.
AERODATABOX_API_KEY=

# ── Gemini (optional) ─────────────────────────────────────────────────────
# Used only to extract flight records from messy JSON and to write plain-English
# explanations. Payout decisions never depend on it.
GEMINI_API_KEY=
# Tried in order; if one is retired or rate-limited the next is used.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# ── API ───────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated; empty = any origin (the API is read-only).
ALLOWED_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000
